{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "theme-1776/testimonial",
	"version": "0.2.0",
	"title": "Testimonial",
	"category": "theme-1776",
	"icon": "format-quote",
	"description": "A client quote with name and role.",
	"keywords": [ "quote", "review", "client" ],
	"textdomain": "1776-wordpress-template",
	"attributes": {
		"quote": { "type": "string", "default": "" },
		"name": { "type": "string", "default": "" },
		"role": { "type": "string", "default": "" }
	},
	"supports": {
		"html": false,
		"color": { "background": true, "text": true },
		"spacing": { "margin": true, "padding": true },
		"shadow": true,
		"__experimentalBorder": { "radius": true, "color": true, "width": true }
	},
	"editorScript": "file:./index.js",
	"style": "file:./style.css",
	"render": "file:./render.php"
}
